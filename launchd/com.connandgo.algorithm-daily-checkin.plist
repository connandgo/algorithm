<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.connandgo.algorithm-daily-checkin</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/connandgo/skala/algorithm/scripts/trigger_daily_checkin.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/connandgo/skala/algorithm</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/connandgo</string>
    <key>GH_CONFIG_DIR</key>
    <string>/Users/connandgo/.config/gh</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>/Users/connandgo/Library/Logs/algorithm-daily-checkin.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/connandgo/Library/Logs/algorithm-daily-checkin.error.log</string>
</dict>
</plist>
